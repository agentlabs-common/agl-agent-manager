{
  "name": "claude-folder-agents",
  "displayName": "AGL Agent Manager",
  "description": "Folder-scoped Claude and Codex sessions with native terminals, Gemini voice control and full-reply TTS.",
  "version": "0.6.1",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeFolderAgents.open",
        "title": "Open Session with Voice",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.refresh",
        "title": "Refresh Sessions",
        "icon": "$(refresh)",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.new",
        "title": "New Agent Session",
        "icon": "$(add)",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.show",
        "title": "Show AGL Agent Manager",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.workspace",
        "title": "Show Sessions in Workspace Folders",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.remote",
        "title": "Open Remote Working Directory over SSH",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.newYolo",
        "title": "New Agent Session (YOLO)",
        "category": "AGL Agent Manager",
        "icon": "$(rocket)"
      },
      {
        "command": "claudeFolderAgents.restartYolo",
        "title": "Restart Session in YOLO Mode",
        "category": "AGL Agent Manager",
        "icon": "$(rocket)"
      },
      {
        "command": "claudeFolderAgents.configureGemini",
        "title": "Configure Gemini Voice",
        "category": "AGL Agent Manager",
        "icon": "$(gear)"
      },
      {
        "command": "claudeFolderAgents.newCodex",
        "title": "New Codex Session",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.newCodexYolo",
        "title": "New Codex Session (YOLO)",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.startCodexDaemon",
        "title": "Start Codex Daemon",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.filterSessions",
        "title": "Filter Sessions",
        "category": "AGL Agent Manager",
        "icon": "$(filter)"
      },
      {
        "command": "claudeFolderAgents.hideSession",
        "title": "Hide Session",
        "category": "AGL Agent Manager",
        "icon": "$(eye-closed)"
      },
      {
        "command": "claudeFolderAgents.restoreSession",
        "title": "Restore Hidden Session",
        "category": "AGL Agent Manager",
        "icon": "$(eye)"
      },
      {
        "command": "claudeFolderAgents.deleteSession",
        "title": "Delete Closed Session…",
        "category": "AGL Agent Manager",
        "icon": "$(trash)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "claudeFolderAgents.sessions",
          "name": "AGL Agent Manager"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeFolderAgents.new",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudeFolderAgents.refresh",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@2"
        },
        {
          "command": "claudeFolderAgents.newYolo",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@3"
        },
        {
          "command": "claudeFolderAgents.configureGemini",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@4"
        },
        {
          "command": "claudeFolderAgents.filterSessions",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@2.5"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeFolderAgents.show",
          "when": "explorerResourceIsFolder && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "navigation@91"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeFolderAgents.restartYolo",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSession/",
          "group": "session@1"
        },
        {
          "command": "claudeFolderAgents.hideSession",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSession(Running|Closed)$/",
          "group": "session@2"
        },
        {
          "command": "claudeFolderAgents.restoreSession",
          "when": "view == claudeFolderAgents.sessions && viewItem == agentSessionHidden",
          "group": "session@2"
        },
        {
          "command": "claudeFolderAgents.deleteSession",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSession(Closed|Hidden)$/",
          "group": "session@3"
        }
      ]
    },
    "configuration": {
      "title": "AGL Agent Manager",
      "properties": {
        "claudeFolderAgents.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the native Claude Code CLI on this computer."
        },
        "claudeFolderAgents.showSaved": {
          "type": "boolean",
          "default": true,
          "description": "Include saved Claude and Codex sessions for the current directory."
        },
        "claudeFolderAgents.voicePython": {
          "type": "string",
          "default": "",
          "description": "Python executable for voice helpers. Live conversations require websockets. Defaults to ~/.venvs/tts/bin/python for Live and python3 for TTS.",
          "scope": "application"
        },
        "claudeFolderAgents.liveBargeIn": {
          "type": "boolean",
          "default": false,
          "description": "Keep the microphone active during readout. Use a headset to avoid transcribing speaker audio.",
          "scope": "application"
        },
        "claudeFolderAgents.yoloMode": {
          "type": "boolean",
          "default": false,
          "description": "Use YOLO when starting or opening eligible sessions. Claude skips permission checks; Codex bypasses approvals and its sandbox. Active Codex turns must finish before changing mode."
        },
        "claudeFolderAgents.ttsModel": {
          "type": "string",
          "default": "",
          "description": "Gemini text-to-speech model for reading messages. Defaults to GEMINI_TTS_MODEL or gemini-3.8-flash-tts. Separate from Gemini Live.",
          "scope": "application"
        },
        "claudeFolderAgents.ttsVoice": {
          "type": "string",
          "default": "",
          "description": "Gemini TTS voice for reading messages. Defaults to GEMINI_TTS_VOICE or Aoede.",
          "scope": "application"
        },
        "claudeFolderAgents.ttsStyle": {
          "type": "string",
          "default": "",
          "description": "Delivery style for Gemini TTS, for example warm, calm, and conversational. Applies on the next readout.",
          "scope": "application"
        },
        "claudeFolderAgents.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Path to the native Codex CLI. Remote SSH hosts use the same command name."
        },
        "claudeFolderAgents.providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "default": [
            "claude",
            "codex"
          ],
          "description": "Agent providers to show for the selected working directory."
        },
        "claudeFolderAgents.liveModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Conversational Gemini Live model for natural turn detection and spoken prompt editing. Defaults to gemini-3.8-live."
        },
        "claudeFolderAgents.livePauseSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "scope": "application",
          "description": "Minimum silence before Gemini considers your spoken turn complete. Gemini can keep waiting for unfinished thoughts. Reconnect Live after changing."
        },
        "claudeFolderAgents.refineSpokenPrompts": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Remove only redundant repetitions and hesitation sounds. Preserve every distinct spoken requirement and fall back to original wording for unsafe edits."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce package",
    "test:host": "xvfb-run -a code --wait --new-window --disable-gpu --disable-extensions --disable-workspace-trust --skip-welcome --skip-release-notes --user-data-dir=/tmp/claude-agents-host-smoke/profile --extensions-dir=/tmp/claude-agents-host-smoke/extensions --extensionDevelopmentPath=. --extensionTestsPath=./scripts/vscode-smoke.cjs ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentlabs-common/claude-folder-agents.git"
  },
  "bugs": {
    "url": "https://github.com/agentlabs-common/claude-folder-agents/issues"
  },
  "homepage": "https://github.com/agentlabs-common/claude-folder-agents#readme",
  "dependencies": {
    "ws": "^8.22.1"
  }
}

{
  "name": "claude-folder-agents",
  "displayName": "AGL Agent Manager",
  "description": "Run a team of Claude Code, Codex and Kimi agents from VS Code: isolated worktree folders, one sidebar with teams, an agent portal for status and messages, and Gemini voice.",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "kimi",
    "ai agents",
    "multi-agent",
    "agent team",
    "coding agent",
    "worktree",
    "agent portal",
    "voice",
    "gemini"
  ],
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "qna": "https://github.com/agentlabs-common/agl-agent-manager/issues",
  "version": "0.14.16",
  "publisher": "Agentlabs",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeFolderAgents.open",
        "title": "Open Session with Voice",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.refresh",
        "title": "Refresh Sessions",
        "icon": "$(refresh)",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.new",
        "title": "New Agent Session",
        "icon": "$(add)",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.show",
        "title": "Show AGL Agent Manager",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.workspace",
        "title": "Show Sessions in Workspace Folders",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.remote",
        "title": "Open Remote Working Directory over SSH",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.newYolo",
        "title": "New Agent Session (YOLO)",
        "category": "AGL Agent Manager",
        "icon": "$(rocket)"
      },
      {
        "command": "claudeFolderAgents.restartYolo",
        "title": "Restart Session in YOLO Mode",
        "category": "AGL Agent Manager",
        "icon": "$(rocket)"
      },
      {
        "command": "claudeFolderAgents.configureGemini",
        "title": "Configure Gemini Voice",
        "category": "AGL Agent Manager",
        "icon": "$(gear)"
      },
      {
        "command": "claudeFolderAgents.newCodex",
        "title": "New Codex Session",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.newCodexYolo",
        "title": "New Codex Session (YOLO)",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.startCodexDaemon",
        "title": "Start Codex Daemon",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.filterSessions",
        "title": "Filter Sessions",
        "category": "AGL Agent Manager",
        "icon": "$(filter)"
      },
      {
        "command": "claudeFolderAgents.hideSession",
        "title": "Hide Session",
        "category": "AGL Agent Manager",
        "icon": "$(eye-closed)"
      },
      {
        "command": "claudeFolderAgents.restoreSession",
        "title": "Restore Hidden Session",
        "category": "AGL Agent Manager",
        "icon": "$(eye)"
      },
      {
        "command": "claudeFolderAgents.deleteSession",
        "title": "Delete Session\u2026",
        "category": "AGL Agent Manager",
        "icon": "$(trash)"
      },
      {
        "command": "claudeFolderAgents.createWorkspace",
        "title": "New Agent",
        "category": "AGL Agent Manager",
        "icon": "$(new-folder)"
      },
      {
        "command": "claudeFolderAgents.refreshWorkspaces",
        "title": "Refresh Workspace Sessions",
        "category": "AGL Agent Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeFolderAgents.openWorkspace",
        "title": "Open Agent",
        "category": "AGL Agent Manager",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeFolderAgents.openWorkspaceFolder",
        "title": "Reveal Agent Folder",
        "category": "AGL Agent Manager",
        "icon": "$(folder)"
      },
      {
        "command": "claudeFolderAgents.chooseWorkspaceAgent",
        "title": "Choose Agent for Workspace Session",
        "category": "AGL Agent Manager",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeFolderAgents.removeWorkspace",
        "title": "Remove Agent Folder\u2026",
        "category": "AGL Agent Manager",
        "icon": "$(trash)"
      },
      {
        "command": "claudeFolderAgents.refreshSkills",
        "title": "Refresh Skills",
        "category": "AGL Agent Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeFolderAgents.openSkill",
        "title": "Open Skill",
        "category": "AGL Agent Manager",
        "icon": "$(book)"
      },
      {
        "command": "claudeFolderAgents.removeSkill",
        "title": "Remove Skill\u2026",
        "category": "AGL Agent Manager",
        "icon": "$(trash)"
      },
      {
        "command": "claudeFolderAgents.createSkill",
        "title": "New Skill",
        "category": "AGL Agent Manager",
        "icon": "$(add)"
      },
      {
        "command": "claudeFolderAgents.importSkill",
        "title": "Import Skill Folder",
        "category": "AGL Agent Manager",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeFolderAgents.enableSkill",
        "title": "Enable Skill",
        "category": "AGL Agent Manager",
        "icon": "$(eye)"
      },
      {
        "command": "claudeFolderAgents.disableSkill",
        "title": "Disable Skill",
        "category": "AGL Agent Manager",
        "icon": "$(eye-closed)"
      },
      {
        "command": "claudeFolderAgents.manageSkills",
        "title": "Manage Skills",
        "category": "AGL Agent Manager",
        "icon": "$(book)"
      },
      {
        "command": "claudeFolderAgents.trustClaudeWorkspace",
        "title": "Trust This Workspace for Claude",
        "category": "AGL Agent Manager",
        "icon": "$(shield)"
      },
      {
        "command": "claudeFolderAgents.openStatusPage",
        "title": "Open Agent Portal",
        "icon": "$(globe)",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.about",
        "title": "Version 0.14.16",
        "category": "AGL Agent Manager"
      },
      {
        "command": "claudeFolderAgents.addToTeam",
        "title": "Add to Team\u2026",
        "category": "AGL Agent Manager",
        "icon": "$(organization)"
      },
      {
        "command": "claudeFolderAgents.removeFromTeam",
        "title": "Remove from Team",
        "category": "AGL Agent Manager",
        "icon": "$(history)"
      },
      {
        "command": "claudeFolderAgents.renameTeam",
        "title": "Rename Team",
        "category": "AGL Agent Manager",
        "icon": "$(edit)"
      },
      {
        "command": "claudeFolderAgents.deleteTeam",
        "title": "Delete Team",
        "category": "AGL Agent Manager",
        "icon": "$(trash)"
      },
      {
        "command": "claudeFolderAgents.stopSession",
        "title": "Stop Agent",
        "category": "AGL Agent Manager",
        "icon": "$(debug-stop)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "claudeFolderAgents.sessions",
          "name": "AGL Agent Manager"
        },
        {
          "id": "claudeFolderAgents.workspaces",
          "name": "AGL Agent Folders"
        },
        {
          "id": "claudeFolderAgents.skills",
          "name": "AGL Skills"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeFolderAgents.openStatusPage",
          "when": "view == claudeFolderAgents.sessions || view == claudeFolderAgents.workspaces",
          "group": "navigation@0"
        },
        {
          "command": "claudeFolderAgents.createWorkspace",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudeFolderAgents.refresh",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@2"
        },
        {
          "command": "claudeFolderAgents.configureGemini",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@4"
        },
        {
          "command": "claudeFolderAgents.filterSessions",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@2.5"
        },
        {
          "command": "claudeFolderAgents.createWorkspace",
          "when": "view == claudeFolderAgents.workspaces",
          "group": "navigation@1"
        },
        {
          "command": "claudeFolderAgents.refreshWorkspaces",
          "when": "view == claudeFolderAgents.workspaces",
          "group": "navigation@2"
        },
        {
          "command": "claudeFolderAgents.createSkill",
          "when": "view == claudeFolderAgents.skills",
          "group": "navigation@1"
        },
        {
          "command": "claudeFolderAgents.importSkill",
          "when": "view == claudeFolderAgents.skills",
          "group": "navigation@2"
        },
        {
          "command": "claudeFolderAgents.refreshSkills",
          "when": "view == claudeFolderAgents.skills",
          "group": "navigation@3"
        },
        {
          "command": "claudeFolderAgents.manageSkills",
          "when": "view == claudeFolderAgents.sessions",
          "group": "navigation@5"
        },
        {
          "command": "claudeFolderAgents.trustClaudeWorkspace",
          "when": "view == claudeFolderAgents.sessions || view == claudeFolderAgents.workspaces",
          "group": "workspace@1"
        },
        {
          "command": "claudeFolderAgents.about",
          "when": "view == claudeFolderAgents.sessions || view == claudeFolderAgents.workspaces",
          "group": "zabout@1"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeFolderAgents.show",
          "when": "explorerResourceIsFolder && (resourceScheme == file || resourceScheme == vscode-remote)",
          "group": "navigation@91"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeFolderAgents.restartYolo",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSession/",
          "group": "session@1"
        },
        {
          "command": "claudeFolderAgents.addToTeam",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSession(Running|Closed)(Team|Ephemeral)$/",
          "group": "session@0"
        },
        {
          "command": "claudeFolderAgents.removeFromTeam",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSession(Running|Closed)Team$/",
          "group": "session@0"
        },
        {
          "command": "claudeFolderAgents.hideSession",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSession(Running|Closed)(Team|Ephemeral)?$/",
          "group": "session@2"
        },
        {
          "command": "claudeFolderAgents.restoreSession",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSessionHidden/",
          "group": "session@2"
        },
        {
          "command": "claudeFolderAgents.stopSession",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSessionRunning(Team|Ephemeral)?$/",
          "group": "session@3"
        },
        {
          "command": "claudeFolderAgents.deleteSession",
          "when": "view == claudeFolderAgents.sessions && viewItem =~ /^agentSession(Running|Closed|Hidden)(Team|Ephemeral)?$/",
          "group": "session@3"
        },
        {
          "command": "claudeFolderAgents.openWorkspace",
          "when": "view == claudeFolderAgents.workspaces && viewItem == aglWorkspace",
          "group": "session@1"
        },
        {
          "command": "claudeFolderAgents.openWorkspaceFolder",
          "when": "view == claudeFolderAgents.workspaces && viewItem == aglWorkspace",
          "group": "session@2"
        },
        {
          "command": "claudeFolderAgents.chooseWorkspaceAgent",
          "when": "view == claudeFolderAgents.workspaces && viewItem == aglWorkspace",
          "group": "session@3"
        },
        {
          "command": "claudeFolderAgents.removeWorkspace",
          "when": "view == claudeFolderAgents.workspaces && viewItem == aglWorkspace",
          "group": "session@4"
        },
        {
          "command": "claudeFolderAgents.openSkill",
          "when": "view == claudeFolderAgents.skills && viewItem =~ /^aglSkill(Enabled|Disabled|ReadOnly)$/",
          "group": "skill@1"
        },
        {
          "command": "claudeFolderAgents.removeSkill",
          "when": "view == claudeFolderAgents.skills && viewItem =~ /^aglSkill(Enabled|Disabled)$/",
          "group": "skill@3"
        },
        {
          "command": "claudeFolderAgents.createSkill",
          "when": "view == claudeFolderAgents.skills && viewItem == aglSkillSource",
          "group": "skill@1"
        },
        {
          "command": "claudeFolderAgents.importSkill",
          "when": "view == claudeFolderAgents.skills && viewItem == aglSkillSource",
          "group": "skill@2"
        },
        {
          "command": "claudeFolderAgents.enableSkill",
          "when": "view == claudeFolderAgents.skills && viewItem == aglSkillDisabled",
          "group": "skill@2"
        },
        {
          "command": "claudeFolderAgents.disableSkill",
          "when": "view == claudeFolderAgents.skills && viewItem == aglSkillEnabled",
          "group": "skill@2"
        },
        {
          "command": "claudeFolderAgents.renameTeam",
          "when": "view == claudeFolderAgents.sessions && viewItem == aglTeam",
          "group": "team@1"
        },
        {
          "command": "claudeFolderAgents.deleteTeam",
          "when": "view == claudeFolderAgents.sessions && viewItem == aglTeam",
          "group": "team@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeFolderAgents.addToTeam",
          "when": "false"
        },
        {
          "command": "claudeFolderAgents.removeFromTeam",
          "when": "false"
        },
        {
          "command": "claudeFolderAgents.renameTeam",
          "when": "false"
        },
        {
          "command": "claudeFolderAgents.deleteTeam",
          "when": "false"
        },
        {
          "command": "claudeFolderAgents.stopSession",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AGL Agent Manager",
      "properties": {
        "claudeFolderAgents.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the native Claude Code CLI on this computer."
        },
        "claudeFolderAgents.showSaved": {
          "type": "boolean",
          "default": true,
          "description": "Include saved Claude and Codex sessions for the current directory."
        },
        "claudeFolderAgents.voicePython": {
          "type": "string",
          "default": "",
          "description": "Python executable for voice helpers. Live conversations require websockets. Defaults to ~/.venvs/tts/bin/python for Live and python3 for TTS.",
          "scope": "application"
        },
        "claudeFolderAgents.liveBargeIn": {
          "type": "boolean",
          "default": false,
          "description": "Keep the microphone active during readout. Use a headset to avoid transcribing speaker audio.",
          "scope": "application"
        },
        "claudeFolderAgents.yoloMode": {
          "type": "boolean",
          "default": false,
          "description": "Use YOLO when starting or opening eligible sessions. Claude skips permission checks; Codex bypasses approvals and its sandbox. Active Codex turns must finish before changing mode."
        },
        "claudeFolderAgents.ttsModel": {
          "type": "string",
          "default": "",
          "description": "Gemini text-to-speech model for reading messages. Defaults to GEMINI_TTS_MODEL or gemini-3.8-flash-tts. Separate from Gemini Live.",
          "scope": "application"
        },
        "claudeFolderAgents.ttsVoice": {
          "type": "string",
          "default": "",
          "description": "Gemini TTS voice for reading messages. Defaults to GEMINI_TTS_VOICE or Aoede.",
          "scope": "application"
        },
        "claudeFolderAgents.ttsStyle": {
          "type": "string",
          "default": "",
          "description": "Delivery style for Gemini TTS, for example warm, calm, and conversational. Applies on the next readout.",
          "scope": "application"
        },
        "claudeFolderAgents.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Path to the native Codex CLI. Remote SSH hosts use the same command name."
        },
        "claudeFolderAgents.kimiPath": {
          "type": "string",
          "default": "kimi",
          "description": "Path to the native Kimi Code CLI. The default also finds ~/.kimi-code/bin/kimi. Kimi sessions are local only."
        },
        "claudeFolderAgents.providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "kimi"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "default": [
            "claude",
            "codex",
            "kimi"
          ],
          "description": "Agent providers to show for the selected working directory."
        },
        "claudeFolderAgents.liveModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Conversational Gemini Live model for natural turn detection and spoken prompt editing. Defaults to gemini-3.8-live."
        },
        "claudeFolderAgents.livePauseSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "scope": "application",
          "description": "Minimum silence before Gemini considers your spoken turn complete. Gemini can keep waiting for unfinished thoughts. Reconnect Live after changing."
        },
        "claudeFolderAgents.refineSpokenPrompts": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Remove only redundant repetitions and hesitation sounds. Preserve every distinct spoken requirement and fall back to original wording for unsafe edits."
        },
        "claudeFolderAgents.workspaceBaseBranch": {
          "type": "string",
          "default": "main",
          "description": "Base branch for canonical clones when creating workspace session worktrees. Uses origin/<branch> when origin exists."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce package",
    "test:host": "xvfb-run -a code --wait --new-window --disable-gpu --disable-extensions --disable-workspace-trust --skip-welcome --skip-release-notes --user-data-dir=/tmp/claude-agents-host-smoke/profile --extensions-dir=/tmp/claude-agents-host-smoke/extensions --extensionDevelopmentPath=. --extensionTestsPath=./scripts/vscode-smoke.cjs ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentlabs-common/agl-agent-manager.git"
  },
  "bugs": {
    "url": "https://github.com/agentlabs-common/agl-agent-manager/issues"
  },
  "homepage": "https://github.com/agentlabs-common/agl-agent-manager#readme",
  "dependencies": {
    "marked": "^15.0.12",
    "ws": "^8.22.1"
  }
}
